@using AutoWeldSystem.Core.DTOs.CenterServer
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="monitor-chart @Kind" @ref="_element" role="img" aria-label="@Description"></div>
@if (_error)
{
    <span class="chart-error">图表暂不可用，请查看设备数量明细</span>
}

@code {
    [Parameter] public string Kind { get; set; } = "production";
    [Parameter] public string Description { get; set; } = "设备产量";
    [Parameter] public IReadOnlyList<CenterDashboardDeviceDto> Devices { get; set; } = [];
    [Parameter] public string? SelectedDeviceId { get; set; }
    [Parameter] public EventCallback<string> OnDeviceSelected { get; set; }

    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _chart;
    private DotNetObjectReference<DashboardChart>? _reference;
    private string? _lastPayload;
    private bool _error;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        try
        {
            if (_chart is null)
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/center-charts.js");
                _reference ??= DotNetObjectReference.Create(this);
                _chart = await _module.InvokeAsync<IJSObjectReference>("create", _element, Kind, _reference);
            }
            var data = Devices.Select(device => new
            {
                id = device.DeviceId,
                name = device.DeviceName,
                total = device.State.ClientOnline && device.HasProductionFor(DateTime.Today) ? (int?)device.TodayTotalCount : null,
                good = device.State.ClientOnline && device.HasProductionFor(DateTime.Today) ? (int?)device.TodayQualifiedCount : null,
                bad = device.State.ClientOnline && device.HasProductionFor(DateTime.Today) ? (int?)device.TodayFailedCount : null,
                selected = device.DeviceId == SelectedDeviceId
            }).ToArray();
            var payload = System.Text.Json.JsonSerializer.Serialize(data);
            if (_lastPayload != payload)
            {
                await _chart.InvokeVoidAsync("update", (object)data);
                _lastPayload = payload;
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException)
        {
            if (!_error)
            {
                _error = true;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    [JSInvokable]
    public Task SelectDevice(string deviceId) => _disposed ? Task.CompletedTask : OnDeviceSelected.InvokeAsync(deviceId);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_chart is not null)
            {
                await _chart.InvokeVoidAsync("dispose");
                await _chart.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        _reference?.Dispose();
    }
}

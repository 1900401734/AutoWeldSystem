@using AutoWeldSystem.Core.DTOs.CenterServer

<header class="monitor-header">
    <div class="monitor-brand">
        <span class="monitor-brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h6l3-4 3 4h6v14H3z" /><path d="m13 8-4 6h4l-2 5 6-7h-4z" /></svg>
        </span>
        <div>
            <h1>焊接生产监控</h1>
            <p>设备运行 · 工单进度 · 生产质量</p>
        </div>
    </div>
    <div class="monitor-header-side">
        <span class="connection-label @(Snapshot.IsDemo ? "is-demo" : Snapshot.ErrorMessage is not null ? "is-unavailable" : null)">
            <i class="dot" aria-hidden="true"></i>@(Snapshot.IsDemo ? "演示数据 · 非现场" : Snapshot.ErrorMessage is not null ? "数据暂不可用" : "中心服务在线")
        </span>
        <div class="monitor-clock">
            <span class="hero-clock-time">@_initialTime</span>
            <span class="hero-clock-date">@_initialDate</span>
        </div>
        <nav class="monitor-actions" aria-label="看板操作">
            <button type="button" class="hero-icon-button" title="全屏 / 退出全屏" aria-label="全屏 / 退出全屏" onclick="awsCenterDisplay.fullscreen()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg>
            </button>
            <button type="button" class="hero-icon-button theme-toggle" onclick="awsCenterTheme.toggle()" title="切换深色/浅色主题" aria-label="切换深色/浅色主题">
                <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1 1m12 12 1 1M5 19l1-1M18 6l1-1" /></svg>
                <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z" /></svg>
            </button>
            <button type="button" class="hero-icon-button @(RailOpen ? "is-active" : null)" title="查看推送日志" aria-label="查看推送日志" aria-expanded="@RailOpen" @onclick="() => OnRailToggleRequested.InvokeAsync()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 8h8M8 12h8M8 16h5" /></svg>
            </button>
            <button type="button" class="hero-icon-button" title="中心服务器设置" aria-label="中心服务器设置" disabled="@Snapshot.IsDemo" @onclick="() => OnSettingsRequested.InvokeAsync()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m9 3-1 3-3 1 1 3-2 2 2 2-1 3 3 1 1 3h6l1-3 3-1-1-3 2-2-2-2 1-3-3-1-1-3z" /><circle cx="12" cy="12" r="3" /></svg>
            </button>
        </nav>
    </div>
</header>

@code {
    [Parameter, EditorRequired] public CenterDashboardSnapshotDto Snapshot { get; set; } = new();
    [Parameter] public EventCallback OnSettingsRequested { get; set; }
    [Parameter] public bool RailOpen { get; set; }
    [Parameter] public EventCallback OnRailToggleRequested { get; set; }

    // 初值不随快照重绘，走字由本地 JS 接管，避免服务器差分把时钟拨回去。
    private readonly string _initialTime = DateTime.Now.ToString("HH:mm:ss");
    private readonly string _initialDate = DateTime.Now.ToString("yyyy.MM.dd dddd");
}

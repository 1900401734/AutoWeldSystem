@using AutoWeldSystem.Core.DTOs.CenterServer
@using AutoWeldSystem.CenterServer.Services

@* 单行顶栏。KPI 并入本栏（原独立 .summary-strip 已取消），
   1366×768 下垂直空间最紧，省下的约 90px 直接留给设备区。 *@
<header class="dashboard-hero">
    <div class="hero-brand">
        <div class="hero-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" /></svg>
        </div>
        <h1>中心服务器看板</h1>
    </div>

    @* 只有 3 个 KPI，不含任何产量汇总：离线设备的陈旧产量数字累加后会误导。 *@
    <div class="hero-kpis">
        <span class="kpi">
            <span class="kpi-label">设备</span>
            <strong class="kpi-value">@Snapshot.Devices.Count</strong>
        </span>
        <span class="kpi">
            <span class="kpi-label">在线</span>
            <strong class="kpi-value kpi-online">@OnlineDeviceCount</strong>
        </span>
        <span class="kpi @(AlarmDeviceCount > 0 ? "kpi-alarm-active" : null)">
            <span class="kpi-label">报警</span>
            <strong class="kpi-value">@AlarmDeviceCount</strong>
        </span>
    </div>

    <div class="hero-spacer"></div>

    <div class="hero-clock">
        <span class="hero-clock-time">@Snapshot.GeneratedAt.ToString("HH:mm:ss")</span>
        <span class="hero-clock-meta">
            <i class="live-dot" aria-hidden="true"></i>实时 @FormatClock(LastRealtimeRefreshAt)
        </span>
    </div>

    <div class="hero-actions">
        @* ≤1200px 时日志栏改为覆盖式抽屉，由本按钮开合；宽屏下常驻，按钮隐藏。 *@
        <button type="button" class="hero-icon-button rail-toggle" title="显示/隐藏日志" aria-label="显示/隐藏日志" @onclick="ToggleRail">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /><path d="M16 13H8" /><path d="M16 17H8" /></svg>
        </button>

        @* 原生 onclick 而非 @onclick：不碰 IJSRuntime，因此预渲染期不会抛异常，
           也不经过 circuit 往返，重连期间依然可以切换主题。 *@
        <button type="button" class="hero-icon-button theme-toggle" onclick="awsCenterTheme.toggle()" title="切换深色/浅色主题" aria-label="切换深色/浅色主题">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" /></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z" /></svg>
        </button>

        <button type="button" class="hero-icon-button" title="中心服务器设置" aria-label="中心服务器设置" @onclick="OpenSettings">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
        </button>
    </div>
</header>

@code {
    [Parameter, EditorRequired]
    public CenterDashboardSnapshotDto Snapshot { get; set; } = new();

    [Parameter]
    public DateTime? LastRealtimeRefreshAt { get; set; }

    [Parameter]
    public DateTime? LastPollingRefreshAt { get; set; }

    /// <summary>齿轮入口：设置抽屉由 Dashboard 持有开合状态。</summary>
    [Parameter]
    public EventCallback OnSettingsRequested { get; set; }

    /// <summary>窄屏下的日志抽屉开合。</summary>
    [Parameter]
    public EventCallback OnRailToggleRequested { get; set; }

    private int OnlineDeviceCount => Snapshot.Devices.Count(it => it.State.ClientOnline);

    private int AlarmDeviceCount => Snapshot.Devices.Count(CenterDashboardStatusPresenter.HasAlarm);

    private Task OpenSettings() => OnSettingsRequested.InvokeAsync();

    private Task ToggleRail() => OnRailToggleRequested.InvokeAsync();

    private static string FormatClock(DateTime? value)
        => value is null ? "--" : value.Value.ToString("HH:mm:ss");
}

@page "/Dashboard"
@using AutoWeldSystem.CenterServer.Configuration
@using AutoWeldSystem.CenterServer.Models
@using AutoWeldSystem.CenterServer.Services
@using AutoWeldSystem.Core.Constants
@using AutoWeldSystem.Core.DTOs.CenterServer
@inject AutoWeldSystem.CenterServer.Services.CenterDashboardQueryService DashboardQuery
@inject AutoWeldSystem.CenterServer.Services.CenterPushJsonlLogService PushLogService
@inject AutoWeldSystem.CenterServer.Services.CenterServerSettingsService SettingsService
@inject AutoWeldSystem.CenterServer.Services.CenterDashboardChangeNotifier ChangeNotifier
@implements IAsyncDisposable

<main class="dashboard-shell">
    <header class="dashboard-header">
        <div>
            <h1>中心服务器看板</h1>
            <p>动态汇总已接入设备的在线状态、工位状态和生产数据。</p>
        </div>
        <div class="dashboard-time">
            <div>@_snapshot.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
            <small>实时：@FormatTime(_lastRealtimeRefreshAt) / 轮询：@FormatTime(_lastPollingRefreshAt)</small>
        </div>
    </header>

    <section class="settings-panel">
        <div class="section-title">
            <h2>中心服务器设置</h2>
            <span>@_settingsMessage</span>
        </div>
        <div class="settings-grid">
            <label class="check-row">
                <input type="checkbox" @bind="_settings.EnableAutoStart" />
                <span>开机自启</span>
            </label>
            <label>
                <span>日志路径</span>
                <input class="text-input" @bind="_settings.LogDirectory" />
            </label>
            <label>
                <span>数据路径</span>
                <input class="text-input" @bind="_settings.DataDirectory" />
            </label>
            <label>
                <span>离线超时（秒）</span>
                <input class="text-input" type="number" min="3" max="3600" @bind="_settings.OfflineTimeoutSeconds" />
            </label>
            <button class="primary-button" @onclick="SaveSettings">保存设置</button>
        </div>
    </section>

    <section class="summary-strip">
        <div><span>设备数</span><strong>@_snapshot.Devices.Count</strong></div>
        <div><span>在线</span><strong>@_snapshot.Devices.Count(it => it.State.ClientOnline)</strong></div>
        <div><span>报警设备</span><strong>@_snapshot.Devices.Count(HasAlarmStation)</strong></div>
        <div><span>今日总数</span><strong>@_snapshot.Devices.Sum(it => it.TodayTotalCount)</strong></div>
        <div><span>合格</span><strong>@_snapshot.Devices.Sum(it => it.TodayQualifiedCount)</strong></div>
        <div><span>不良</span><strong>@_snapshot.Devices.Sum(it => it.TodayFailedCount)</strong></div>
    </section>

    @foreach (var group in _snapshot.Devices.GroupBy(it => string.IsNullOrWhiteSpace(it.SystemType) ? CenterServerConstants.SystemTypes.Other : it.SystemType))
    {
        <section class="device-group">
            <h2>@ResolveSystemTypeName(group.Key)</h2>
            <div class="device-grid">
                @foreach (var device in group)
                {
                    <article class="device-card @ResolveDeviceStatusClass(device)">
                        <div class="device-card-header">
                            <div>
                                <h3>@FirstNonEmpty(device.DeviceName, device.DeviceId)</h3>
                                <p>@device.DeviceId</p>
                            </div>
                            <span class="online-badge @(device.State.ClientOnline ? "online" : "offline")">
                                @(device.State.ClientOnline ? "在线" : "离线")
                            </span>
                        </div>

                        @if (device.Stations.Count == 0)
                        {
                            <p class="empty-station-text">尚未收到工位数据</p>
                        }
                        else
                        {
                            @foreach (var station in device.Stations)
                            {
                                <section class="station-panel @ResolveStationStatusClass(station)">
                                    <div class="station-title">
                                        <strong>工位 @station.StationNo</strong>
                                        <span>@station.State.PlcDeviceStatusName</span>
                                    </div>
                                    <div class="status-row">
                                        <span>PLC连接</span>
                                        <strong>@(station.State.PlcConnected ? "已连接" : "未连接")</strong>
                                    </div>
                                    <div class="status-row">
                                        <span>当前工单</span>
                                        <strong>@FirstNonEmpty(station.CurrentWorkOrder, "--")</strong>
                                    </div>
                                    <div class="status-row">
                                        <span>产品工号</span>
                                        <strong>@FirstNonEmpty(station.ProductJobNo, station.ProductModel, "--")</strong>
                                    </div>
                                    <div class="count-row">
                                        <div><span>总数</span><strong>@station.TodayTotalCount</strong></div>
                                        <div><span>合格</span><strong>@station.TodayQualifiedCount</strong></div>
                                        <div><span>不良</span><strong>@station.TodayFailedCount</strong></div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(station.State.AlarmMessage))
                                    {
                                        <p class="alarm-text">工位 @station.StationNo：@station.State.AlarmMessage</p>
                                    }
                                </section>
                            }
                        }

                        <p class="update-text">最后更新：@FormatTime(device.State.LastSeenAt)</p>
                    </article>
                }
            </div>
        </section>
    }

    <section class="log-panel">
        <div class="section-title">
            <h2>设备推送日志</h2>
            <span>读取 JSONL 文件，不依赖数据库</span>
        </div>
        <div class="log-filter">
            <input class="text-input" placeholder="设备名称/编号" @bind="_logDeviceKeyword" />
            <input class="text-input" placeholder="工位" type="number" @bind="_logStationText" />
            <select class="text-input" @bind="_logRequestType">
                <option value="">全部类型</option>
                <option value="telemetry">telemetry</option>
                <option value="heartbeat">heartbeat</option>
                <option value="product-report">product-report</option>
            </select>
            <input class="text-input" placeholder="关键字" @bind="_logKeyword" />
            <button class="primary-button" @onclick="RefreshLogs">查询</button>
        </div>
        <div class="log-table-wrap">
            <table class="log-table">
                <thead>
                    <tr>
                        <th>时间</th>
                        <th>类型</th>
                        <th>设备</th>
                        <th>工位</th>
                        <th>结果</th>
                        <th>消息</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in _logs)
                    {
                        <tr class="@(log.Success ? "log-success" : "log-failed")">
                            <td>@log.ReceivedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@log.RequestType</td>
                            <td>@FirstNonEmpty(log.DeviceName, log.DeviceId, "--")</td>
                            <td>@(log.StationNo <= 0 ? "--" : log.StationNo)</td>
                            <td>@(log.Success ? "成功" : "失败")</td>
                            <td>@FirstNonEmpty(log.Error, log.Message, "--")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>

@code {
    private CenterDashboardSnapshotDto _snapshot = new();
    private CenterServerLocalSettings _settings = new();
    private IReadOnlyList<CenterPushLogRecord> _logs = [];
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private string _settingsMessage = string.Empty;
    private DateTime? _lastRealtimeRefreshAt;
    private DateTime? _lastPollingRefreshAt;
    private string _logDeviceKeyword = string.Empty;
    private string _logStationText = string.Empty;
    private string _logRequestType = string.Empty;
    private string _logKeyword = string.Empty;

    protected override Task OnInitializedAsync()
    {
        _settings = SettingsService.Get();
        _snapshot = DashboardQuery.GetSnapshot();
        RefreshLogs();
        _cts = new CancellationTokenSource();
        ChangeNotifier.DashboardChanged += ChangeNotifier_DashboardChanged;
        _settingsMessage = "实时刷新已启用，轮询每 10 秒兜底。";
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = RefreshLoopAsync(_cts.Token);

        return Task.CompletedTask;
    }

    private void ChangeNotifier_DashboardChanged(object? sender, CenterDashboardChangedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            RefreshDashboardSnapshot();
            _lastRealtimeRefreshAt = e.ChangedAt;
            StateHasChanged();
        });
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        if (_timer is null)
        {
            return;
        }

        try
        {
            while (await _timer.WaitForNextTickAsync(cancellationToken))
            {
                RefreshDashboardSnapshot(cancellationToken);
                _lastPollingRefreshAt = DateTime.Now;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The dashboard page was closed; no further refresh work is required.
        }
    }

    private void SaveSettings()
    {
        SettingsService.Save(_settings);
        _settings = SettingsService.Get();
        _settingsMessage = $"已保存：{DateTime.Now:HH:mm:ss}";
        RefreshLogs();
    }

    private void RefreshDashboardSnapshot(CancellationToken cancellationToken = default)
    {
        _snapshot = DashboardQuery.GetSnapshot(cancellationToken);
        RefreshLogs();
    }

    private void RefreshLogs()
    {
        _logs = PushLogService.QueryRecent(new CenterPushLogQuery
        {
            DeviceKeyword = _logDeviceKeyword,
            StationNo = int.TryParse(_logStationText, out var stationNo) && stationNo > 0 ? stationNo : null,
            RequestType = _logRequestType,
            Keyword = _logKeyword,
            Limit = 200
        });
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        ChangeNotifier.DashboardChanged -= ChangeNotifier_DashboardChanged;
        _timer?.Dispose();
        _cts?.Dispose();
        await Task.CompletedTask;
    }

    private static bool HasAlarmStation(CenterDashboardDeviceDto device)
        => device.Stations.Any(station => station.State.PlcDeviceStatusCode == "4");

    private static string ResolveDeviceStatusClass(CenterDashboardDeviceDto device)
    {
        if (!device.State.ClientOnline)
        {
            return "offline-card";
        }

        if (device.Stations.Any(station => station.State.PlcDeviceStatusCode == "4"))
        {
            return "alarm-card";
        }

        if (device.Stations.Any(station => station.State.PlcDeviceStatusCode == "1"))
        {
            return "running-card";
        }

        if (device.Stations.Any(station => station.State.PlcDeviceStatusCode == "2"))
        {
            return "paused-card";
        }

        if (device.Stations.Any(station => station.State.PlcDeviceStatusCode == "3"))
        {
            return "stopped-card";
        }

        return "unknown-card";
    }

    private static string ResolveStationStatusClass(CenterDashboardStationDto station)
    {
        return station.State.PlcDeviceStatusCode switch
        {
            "1" => "station-running",
            "2" => "station-paused",
            "3" => "station-stopped",
            "4" => "station-alarm",
            _ => "station-unknown"
        };
    }

    private static string ResolveSystemTypeName(string value)
    {
        return value switch
        {
            CenterServerConstants.SystemTypes.Electromagnetic => "电磁系统",
            CenterServerConstants.SystemTypes.WholePiece => "整件系统",
            _ => "其它"
        };
    }

    private static string FormatTime(DateTime? value)
        => value is null ? "--" : value.Value.ToString("yyyy-MM-dd HH:mm:ss");

    private static string FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;
}

@page "/"
@namespace AutoWeldSystem.CenterServer.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f1620" />
    <title>中心服务器看板</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2312202d'/%3E%3Cpath d='M17.5 5 8 18h6l-1.5 9L22 14h-6l1.5-9z' fill='%232a78d6'/%3E%3C/svg%3E" />
    <link rel="stylesheet" href="css/center-dashboard.css" />
    @* 样式表链接是渲染阻塞的，其后的经典内联脚本在首次绘制前执行，
       因此首屏即为正确主题，不会出现先浅后深的闪烁。 *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('aws-center-theme');
                if (t !== 'light' && t !== 'dark') { t = 'dark'; }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
    <script src="js/center-theme.js"></script>
</head>
<body>
    <component type="typeof(Dashboard)" render-mode="ServerPrerendered" />
    <script src="_framework/blazor.server.js"></script>
</body>
</html>

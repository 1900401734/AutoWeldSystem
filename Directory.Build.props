<Project>
  <PropertyGroup>
    <Product>AutoWeldSystem</Product>
    <Company>AutoWeldSystem</Company>
    <Version>3.8.1</Version>
    <AssemblyVersion>3.8.1.0</AssemblyVersion>
    <FileVersion>3.8.1.0</FileVersion>
    <InformationalVersion>3.8.1</InformationalVersion>
    <!-- 符号嵌入程序集：单文件发布后没有松散 pdb，嵌入才能保留异常日志中的源码行号。 -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
